@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a1b10;--fg:#f1dcb4;--ac:#e0702f;--pn:rgba(42,27,16,.95);--bd:#c08a4c;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#2a1b10;--fg:#f1dcb4;--ac:#e0702f;--pn:rgba(42,27,16,.95);--bd:#c08a4c;color-scheme:dark}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg);color:var(--fg);font-family:Georgia,"Times New Roman",serif}
#cv{position:fixed;inset:0;width:100%;height:100%}
.ov{position:fixed;inset:0;display:flex;align-items:flex-start;justify-content:center;overflow:auto;padding:12px;box-sizing:border-box}
.pn{background:var(--pn);border:2px solid var(--bd);border-radius:12px;padding:14px 18px;max-width:720px;width:100%;margin:auto;box-sizing:border-box;text-align:center}
h1{margin:0;font-size:28px;letter-spacing:2px;color:var(--ac)}h2{margin:12px 0 6px;font-size:16px}p{margin:6px 0}
.row{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:8px 0}
.b{font:inherit;font-weight:bold;padding:10px 16px;border-radius:8px;border:2px solid var(--bd);background:var(--ac);color:#fff;cursor:pointer}.b:disabled{opacity:.4}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.cd{border:2px solid var(--bd);border-radius:8px;padding:8px;cursor:pointer;text-align:left;font-size:13px}.cd.on{background:var(--ac);color:#fff}.cd small{display:block;opacity:.85;margin-top:3px}
.hd{position:fixed;top:calc(env(safe-area-inset-top,0px) + 8px);left:8px;width:200px;background:var(--pn);border:1px solid var(--bd);border-radius:8px;padding:8px;font-size:13px}
.bar{height:9px;background:rgba(0,0,0,.25);border-radius:5px;margin:4px 0 8px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--ac)}
#msg{position:fixed;top:30%;left:0;right:0;text-align:center;font-size:72px;font-weight:bold;color:#fff;text-shadow:0 3px 8px #000;pointer-events:none}
#tc{position:fixed;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 10px);display:flex;justify-content:space-between;padding:0 10px;touch-action:none}
#tc button{font-size:20px;padding:16px 18px;border-radius:12px;border:2px solid var(--bd);background:var(--pn);color:var(--fg);touch-action:none}
.ar{font-size:64px;animation:p .5s infinite alternate}@keyframes p{to{transform:scale(1.3) rotate(-20deg)}}
[hidden]{display:none!important}
</style></head><body>
